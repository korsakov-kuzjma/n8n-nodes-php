{
  "name": "n8n-nodes-php",
  "version": "2.0.1",
  "description": "Community node to execute arbitrary PHP code in n8n workflows",
  "license": "MIT",
  "author": {
    "name": "korsakov-kuzjma",
    "email": "korsakov.kuzjma@gmail.com",
    "url": "https://github.com/korsakov-kuzjma"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korsakov-kuzjma/n8n-nodes-php.git"
  },
  "homepage": "https://github.com/korsakov-kuzjma/n8n-nodes-php#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "php",
    "code",
    "execute"
  ],
  "scripts": {
    "build": "n8n-node build && node scripts/bundle.mjs",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "jest",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [],
    "nodes": [
      "dist/nodes/PhpExecute/PhpExecute.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/jest": "^29.5.14",
    "esbuild": "^0.28.2",
    "eslint": "9.29.0",
    "jest": "^29.7.0",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
